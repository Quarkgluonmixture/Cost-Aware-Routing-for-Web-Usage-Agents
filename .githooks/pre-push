#!/usr/bin/env bash
# P79 doc-numbering guard (pre-push, v2) — block cross-session §-number collisions
# in 实验笔记.md (enforcing) + warn on master_bug_catalog.md B-numbers (advisory)
# before they reach the shared remote.
#
# Versioned under .githooks/ (travels across DGX/A100/quark/Myriad clones).
# Activate per clone once:  bash scripts/maintenance/install_doc_guard_hooks.sh
#
# v2 (codex race review 2026-05-22): checks the COMMIT being pushed (from pre-push
# stdin), not the working tree. Fail-open on setup problems (missing script / no
# python / offline) — only a real section collision returns non-zero.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
CHECK="$REPO_ROOT/scripts/maintenance/check_doc_numbering.py"
[ -f "$CHECK" ] || exit 0

if [ -n "${P79_PYTHON:-}" ] && [ -x "${P79_PYTHON}" ]; then
  PYBIN="$P79_PYTHON"
elif [ -x "$REPO_ROOT/.venv/bin/python3" ]; then
  PYBIN="$REPO_ROOT/.venv/bin/python3"
else
  PYBIN="$(command -v python3 || true)"
fi
[ -n "$PYBIN" ] || exit 0

REMOTE_NAME="${1:-origin}"

# pre-push stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
# Take the first non-delete local_sha (this repo's workflow = single master push).
local_sha=""
while read -r _lref lsha _rref _rsha; do
  [ -z "$lsha" ] && continue
  printf '%s' "$lsha" | grep -qE '^0+$' && continue   # all-zero sha = branch delete
  local_sha="$lsha"; break
done
[ -z "$local_sha" ] && local_sha="$(git rev-parse HEAD 2>/dev/null)"

echo "[doc-guard] checking §/B collisions for ${local_sha:0:8} vs ${REMOTE_NAME}/master ..."
git fetch -q "$REMOTE_NAME" master 2>/dev/null \
  || echo "[doc-guard] ⚠ fetch failed (offline?) — cross-session check degraded"

"$PYBIN" "$CHECK" --local-sha "$local_sha" --remote-ref "${REMOTE_NAME}/master"
