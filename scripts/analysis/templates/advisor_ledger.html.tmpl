      「253 节」不矛盾：前者枚举所有标题层级，后者按五批产出统计主题数。</td></tr>
    </tbody></table></div></div>`;

/* ── view: running ── */
document.getElementById('v-running').innerHTML = `
  <h2>在跑的</h2>
  <p class="lede">状态会变。<b>不要信这页的快照，用右边的命令去查。</b></p>
  ` + D.run.map(r => `
  <div class="run">
    <h3>${esc(r.what)}</h3>
    <div class="meta">${esc(r.where)}</div>
    <code>${esc(r.how_to_check)}</code>
    <div class="note">${esc(r.note)}</div>
  </div>`).join('');

/* ── nav ── */
const VIEWS = [
  ['v-decide', '要定的', D.dec.length],
  ['v-sections', '全部结论', D.sec.length],
  ['v-coverage', '覆盖度自证', ''],
  ['v-running', '在跑的', D.run.length],
];
const nav = document.getElementById('nav');
nav.innerHTML = VIEWS.map(([id, label, n], i) =>
  `<button role="tab" data-v="${id}" aria-selected="${i===0}">${esc(label)}${
    n!==''?`<span class="cnt">${n}</span>`:''}</button>`).join('');
nav.addEventListener('click', e => {
  const b = e.target.closest('button'); if (!b) return;
  nav.querySelectorAll('button').forEach(x =>
    x.setAttribute('aria-selected', String(x === b)));
  VIEWS.forEach(([id]) =>
    document.getElementById(id).hidden = (id !== b.dataset.v));
});
</script>

