#!/usr/bin/env bash
# Copy to scripts/vwa_env_remote.sh and replace VWA_REMOTE_HOST + populate
# VWA_<SITE>_USER / VWA_<SITE>_PASS values from your VWA secrets.
#
# B-1574 (/stress A1.24 P0-5-BC + P1-7-C, 2026-05-18): VWA_*_USER/PASS env
# vars are REQUIRED by p79/utils/auth_refresh.py:46-51 _ACCOUNT_ENV_KEYS for
# auth_required_gate() to function. Pre-fix this template was incomplete and
# operators had to reverse-engineer the names from code comments.
#
# Canonical login identities per
# external/visualwebarena/browser_env/env_config.py:91 and CLAUDE.md memory:
#   classifieds    → blake.sullivan@gmail.com
#   reddit         → MarvelsGrantMan136
#   shopping       → emma.lopez@gmail.com         (Phase 1b)
#   shopping_admin → admin                        (Phase 1b)
# Passwords ship with the VWA Docker images — see VWA upstream README or
# `external/visualwebarena/environment_docker/.env`.

export DATASET=visualwebarena

VWA_REMOTE_HOST="${VWA_REMOTE_HOST:-YOUR_WSL_HOST_OR_TAILSCALE_IP}"

export CLASSIFIEDS="http://${VWA_REMOTE_HOST}:9980"
export CLASSIFIEDS_RESET_TOKEN="4b61655535e7ed388f0d40a93600254c"

export SHOPPING="http://${VWA_REMOTE_HOST}:7770"
export REDDIT="http://${VWA_REMOTE_HOST}:9999"
export WIKIPEDIA="http://${VWA_REMOTE_HOST}:8888"
export HOMEPAGE="http://${VWA_REMOTE_HOST}:4399"

# Phase 1a (cls + reddit) — REQUIRED
export VWA_CLASSIFIEDS_USER="blake.sullivan@gmail.com"
export VWA_CLASSIFIEDS_PASS="REPLACE_WITH_VWA_PASSWORD"
export VWA_REDDIT_USER="MarvelsGrantMan136"
export VWA_REDDIT_PASS="REPLACE_WITH_VWA_PASSWORD"

# Phase 1b (shopping + shopping_admin) — required when launching shop conditions
export VWA_SHOPPING_USER="emma.lopez@gmail.com"
export VWA_SHOPPING_PASS="REPLACE_WITH_VWA_PASSWORD"
export VWA_SHOPPING_ADMIN_USER="admin"
export VWA_SHOPPING_ADMIN_PASS="REPLACE_WITH_VWA_PASSWORD"

# B-1578 (/stress A1.24 hot follow-up, 2026-05-18): auto-source ~/.api_keys.env
# (operator-managed, host-local) for HF_TOKEN + OPENAI_API_KEY. Required by
# snapshot_env.py paper-grade Phase 0 check for gated HF models (e.g.
# google/gemma-3-4b-it). Without these, P79_PAPER_GRADE=1 refuses to run with
# "FATAL: paper-baseline model(s) failed SHA capture: gated_no_token".
# Operator setup: `cat > ~/.api_keys.env` with two exports:
#   export HF_TOKEN="hf_..."           # huggingface.co/settings/tokens (read access)
#   export OPENAI_API_KEY="sk-..."     # or ANTHROPIC_API_KEY / PROXY_API_KEY per backend
# Then `chmod 600 ~/.api_keys.env`.
[ -f "$HOME/.api_keys.env" ] && source "$HOME/.api_keys.env"
