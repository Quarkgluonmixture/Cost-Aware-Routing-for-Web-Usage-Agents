#!/bin/bash -l
# P79 Myriad onboarding smoke test — COMPUTE node side
#
# Submit with: qsub scripts/myriad/smoke_compute.qsub
# Output:      ./p79_smoke_compute.o<JOB_ID>  (cwd at submit time)
#
# 10-min job on 1×A100-40G (L node). Verifies onboarding step 5 (torch CUDA bf16),
# plus VWA Tailscale reachability and HF Hub egress from compute node — these
# can differ from login-node behaviour due to UCL egress policy.
#
# Sized small so queue wait is low; for full-host benchmark do a separate run.

#$ -N p79_smoke_compute
#$ -l h_rt=00:10:00
#$ -l mem=8G
#$ -l gpu=1
#$ -ac allow=L
#$ -cwd
#$ -j y

set -uo pipefail

VWA_HOST="${VWA_HOST:?VWA_HOST must be set (e.g. quark Tailscale IP)}"
VWA_PORTS=(9980 7770 9999 4399)    # cls / shop / reddit / homepage
DGX_HOST="spark-9ea3"

PASS=0; FAIL=0; WARN=0
ok()   { echo "  [PASS] $*"; PASS=$((PASS+1)); }
bad()  { echo "  [FAIL] $*"; FAIL=$((FAIL+1)); }
warn() { echo "  [WARN] $*"; WARN=$((WARN+1)); }
probe_tcp() { timeout 5 bash -c ">/dev/tcp/$1/$2" 2>/dev/null; }

cat <<HDR
===== P79 Myriad smoke (COMPUTE node) =====
Time:     $(date -Iseconds)
Job:      ${JOB_NAME:-?} (id ${JOB_ID:-?})
Host:     $(hostname)
PWD:      $(pwd)
HDR

echo
echo "----- [1] Node info -----"
grep -m1 "model name" /proc/cpuinfo || true
echo "  Cores allocated (NSLOTS): ${NSLOTS:-unset}"
grep -E "MemTotal|MemAvailable" /proc/meminfo
df -h /tmp 2>/dev/null | head -2 || true
df -h "${TMPDIR:-/tmp}" 2>/dev/null | head -2 || true

echo
echo "----- [2] GPU (nvidia-smi) -----"
if nvidia-smi 2>/dev/null; then
  ok "nvidia-smi succeeded"
else
  bad "nvidia-smi failed — GPU not allocated or driver issue"
fi

echo
echo "----- [3] Module load + Torch + bf16 matmul -----"
module unload compilers mpi gcc-libs 2>/dev/null || true
module load gcc-libs/10.2.0          2>/dev/null || warn "gcc-libs/10.2.0 not loaded"
module load python3/3.9-gnu-10.2.0   2>/dev/null || warn "python3/3.9 not loaded"
module load cuda/11.3.1/gnu-10.2.0   2>/dev/null || warn "cuda/11.3.1 not loaded"
module load cudnn/8.2.1.32/cuda-11.3 2>/dev/null || warn "cudnn 8.2.1 not loaded"
module load pytorch/1.11.0/gpu       2>/dev/null || warn "pytorch/1.11.0/gpu not loaded — try newer if available"
echo "  Loaded modules:"
module list 2>&1 | sed 's/^/    /' || true

echo
echo "  Torch bf16 GPU smoke:"
python3 - <<'PY' || bad "Python smoke crashed"
import sys, traceback
print(f"    python: {sys.version.split()[0]}")
try:
    import torch
    print(f"    torch:  {torch.__version__}")
    print(f"    cuda available: {torch.cuda.is_available()}")
    if not torch.cuda.is_available():
        print("    [FAIL] cuda not available inside this job")
        sys.exit(2)
    print(f"    devices: {torch.cuda.device_count()}")
    print(f"    name(0): {torch.cuda.get_device_name(0)}")
    print(f"    cap(0):  {torch.cuda.get_device_capability(0)}  (need >=8.0 for native bf16)")
    x = torch.randn(1024, 1024, device="cuda", dtype=torch.bfloat16)
    y = torch.randn(1024, 1024, device="cuda", dtype=torch.bfloat16)
    z = (x @ y).sum().item()
    print(f"    [PASS] bf16 matmul -> sum={z:.3e}")
except Exception as e:
    print(f"    [FAIL] {type(e).__name__}: {e}")
    traceback.print_exc()
    sys.exit(3)
PY

echo
echo "----- [4] VWA reach (COMPUTE side) -----"
echo "  Outbound HTTPS sanity:"
curl -sS -o /dev/null -w "    google.com -> %{http_code} %{time_total}s\n" \
  --connect-timeout 5 --max-time 10 https://www.google.com || warn "outbound HTTPS blocked from compute"
curl -sS -o /dev/null -w "    huggingface.co -> %{http_code} %{time_total}s\n" \
  --connect-timeout 5 --max-time 10 https://huggingface.co || warn "HF Hub blocked — model download will need staging via login node"

echo "  Tailscale ${VWA_HOST} TCP probe:"
TS_OK=0
for port in "${VWA_PORTS[@]}"; do
  if probe_tcp "${VWA_HOST}" "${port}"; then
    ok "${VWA_HOST}:${port} reachable"
    TS_OK=$((TS_OK+1))
  else
    warn "${VWA_HOST}:${port} unreachable from compute node"
  fi
done
echo "  -> ${TS_OK}/${#VWA_PORTS[@]} VWA ports reachable from compute"

echo
echo "----- [5] Hub-spoke — DGX reach from compute -----"
if probe_tcp "${DGX_HOST}" 22; then
  ok "${DGX_HOST}:22 reachable from compute — rsync from job script viable"
else
  warn "${DGX_HOST}:22 unreachable from compute — push results from login node post-job"
fi

echo
echo "===== SUMMARY (COMPUTE) ====="
echo "  PASS=${PASS}  FAIL=${FAIL}  WARN=${WARN}"
echo "  TS_OK=${TS_OK}/${#VWA_PORTS[@]}"
echo
if [[ "${TS_OK}" -ge 3 ]]; then
  echo "  Verdict: B1 baselines on Myriad ARE viable (VWA reachable from compute)."
  echo "  Next: full onboarding (README §139 step 4-6), then queue B1 cross-site parallel:"
  echo "      L_node1: B1_phantom_som_classifieds"
  echo "      L_node2: B1_dom_reddit"
  echo "      L_node3: B1_vision_shopping"
elif [[ "${TS_OK}" -gt 0 ]]; then
  echo "  Verdict: VWA partially reachable (${TS_OK}/${#VWA_PORTS[@]}). Inspect blocked ports."
else
  echo "  Verdict: VWA UNREACHABLE from compute. Even if login can reach Tailscale,"
  echo "  compute-node egress is the binding constraint for runtime jobs. Options listed in login smoke."
fi
