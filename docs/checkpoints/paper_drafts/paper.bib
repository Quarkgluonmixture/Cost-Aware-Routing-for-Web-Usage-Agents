@misc{ullrich2025openapps,
  title = {{OpenApps}: Simulating Environment Variations to Measure {UI}-Agent Reliability},
  author = {Ullrich, Karen and Su, Jingtong and Shi, Claudia and Subramonian, Arjun and others},
  year = {2025},
  eprint = {2511.20766},
  archivePrefix = {arXiv},
  primaryClass = {cs.AI},
  url = {https://arxiv.org/abs/2511.20766},
  note = {6 toy FastHTML apps with YAML-parameterised environment variations and fully deterministic state indicators. Two findings used in the thesis: (a) GPT-4o vision-only scores 0 vs 82--90 with AXTree access on their 15-task suite --- an extreme observation-mode first-order effect; (b) fixed-app SR variance understates across-variation deployment variance by $>2\times$ (Qwen2.5-VL within 16.8 vs across 32.0) --- motivates our per-(site, model) stratification and ``within this environment instantiation'' claim wording. Quote: agent-failure reporting usually relies on ``anecdotal evidence alone''. Caveat: 15 tasks = small-n extremes; reliability here = SR variance under perturbation, NOT evaluator correctness (different estimand from our FP-audit line). Preprint; id verified via API 2026-06-10.}
}

