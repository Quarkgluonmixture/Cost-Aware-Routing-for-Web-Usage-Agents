@article{zhou2026visualignorance,
  title = {Diagnosing Visual Ignorance in Vision-Language Models},
  author = {Zhou, Runyu and Zhang, Qi and Wang, Qixun and Wang, Yisen},
  year = {2026},
  journal = {arXiv preprint arXiv:2606.06890},
  primaryClass = {cs.CV},
  note = {Dual-lens study of VLM language-prior reliance. Behavioral: progressive Gaussian blur (8 kernels) over 12 VQA benchmarks $\times$ 3 VLMs (Qwen2.5-VL-3B/7B, LLaVA-1.6-Mistral-7B) tracking consecutive-identical answers; 20--40\% of samples are answered identically under total visual occlusion (RePOPE/MMMU $\sim$40\%) $\to$ ``benchmarks reward visual ignorance''. Mechanistic: counterfactual layer replacement + layer-wise MLP probing localize a two-stage suppression --- middle layers carry the visual signal, late layers ($\sim$final third) re-inject text-space priors (language-prior prob $>$0.6). Directly cites MIRAGE and positions itself as a strict-superset method (multi-step consecutive-consistency lower bound vs MIRAGE's binary image-present/absent comparison). Cited in our paper \S 2.4 as the fresher behavioral anchor for language-prior dominance, alongside MIRAGE \citep{asadi2026mirageillusionvisualunderstanding} + Scaffold \citep{vu2026scaffold}. CAVEAT: single-image VQA domain, not web agents; ``visual ignorance'' = discarding a PRESENT image, whereas Phantom-SoM REMOVES the image while preserving its element index as text --- motivational transfer only. The mechanism half (layer replacement / MLP probe) maps to the deferred paper-2 \S 5 (same toolkit as our shelved patching/probe plan). Added 2026-06-15 from cron\_digest\_2026-06-12 triage, arXiv id API-verified.}
}

