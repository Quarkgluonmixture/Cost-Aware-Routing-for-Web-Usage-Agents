   130	        summary_parts.append(args.config.read_text(encoding="utf-8")[:2000])
   131	
   132	    summary_parts.append("\n=== ACTIVE RUNS (pgrep) ===")
   133	    summary_parts.append(get_active_runs() or "(none)")
   134	
   135	    launch_summary = "\n".join(summary_parts)
