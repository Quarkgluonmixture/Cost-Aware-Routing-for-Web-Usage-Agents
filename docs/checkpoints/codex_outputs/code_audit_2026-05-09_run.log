     1	"""Preregistration decision test — H1 / H3 / TOST canonical implementation.
     2	
     3	Single source of truth for the paper §5 / Table 5 decision rules.
     4	Once advisor's email reply confirms thresholds (K_h1 / K_h3 / TOST δ),
     5	this script takes 16-cell SR data + emits deterministic pass/fail JSON.
     6	
     7	Tied to:
     8	- preregistration.md (commitment text)
     9	- osf_lock_manifest.md (lock SHA chain)
    10	- run_manifest.yaml (cell scope)
    11	- 笔记 §114 (provenance hardening)
    12	
    13	Hypotheses:
    14	- H1: Phantom-SoM ≥ best (DOM, SoM, Vision) in ≥ K_h1 cells
    15	- H3: Drop-one oracle lift from Phantom-SoM ≥ <delta_pp> in ≥ K_h3 cells
    16	- TOST: |cost(P-SoM) - cost(DOM)| < δ (equivalence test)
    17	
    18	Usage:
    19	    # With actual data:
    20	    python3 scripts/analysis/preregistration_decision_test.py \\
    21	        --cells-csv results/phantom_paper/cells_aggregated.csv \\
    22	        --thresholds K_h1=12 K_h3=11 TOST_delta=1.0 \\
    23	        --out results/phantom_paper/preregistration_test_results.json
    24	
    25	    # Smoke test on synthetic data:
    26	    python3 scripts/analysis/preregistration_decision_test.py --synthetic --seed 0
    27	
    28	Inputs (CSV schema):
    29	    cell_id,baseline,site,phantom_axis,sr_dom,sr_som,sr_vision,sr_phantom_som,
    30	        sr_phantom_text,sr_phantom_prompt,oracle_3mode,oracle_drop_one_psom,
    31	        cost_dom,cost_psom
    32	
    33	Outputs (JSON):
    34	    {
    35	      "captured_at": "...",
    36	      "n_cells": 16,
    37	      "thresholds": {"K_h1": 12, "K_h3": 11, "TOST_delta_pp": 1.0},
    38	      "H1": {"per_cell_winners": [...], "n_pass": 12, "decision": "PASS|FAIL", "p_binomial": ...},
    39	      "H3": {"per_cell_lift_pp": [...], "n_pass": 10, "decision": "PASS|FAIL"},
    40	      "TOST": {"observed_delta_pp": 0.7, "ci_95": [-0.4, 1.8], "decision": "PASS|FAIL"},
    41	      "overall_decision": "...",
    42	      "input_data_sha256": "..."
    43	    }
    44	"""
    45	
    46	from __future__ import annotations
    47	
    48	import argparse
    49	import csv
    50	import hashlib
    51	import json
    52	import logging
    53	import math
    54	import sys
    55	from datetime import datetime, timezone
    56	from pathlib import Path
    57	from typing import Optional
