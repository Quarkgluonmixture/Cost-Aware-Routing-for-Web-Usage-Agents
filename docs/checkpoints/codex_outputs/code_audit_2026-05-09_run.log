   252	    paper_cells = [cell for cell in cells if cell.grade in DEFAULT_GRADE_FILTER]
   253	    paper_groups: dict[tuple[str, str], int] = {}
   254	    for cell in paper_cells:
   255	        paper_groups[(cell.baseline, cell.site)] = paper_groups.get((cell.baseline, cell.site), 0) + 1
   256	    paper_detail = ", ".join(f"{baseline} {site}={count}" for (baseline, site), count in sorted(paper_groups.items()))
   257	    lines: list[str] = [f"Paper-grade cells: {len(paper_cells)} ({paper_detail})"]
   258	    for grade in GRADES:
   259	        grade_cells = [cell for cell in cells if cell.grade == grade]
   260	        if not grade_cells:
   261	            continue
   262	        groups: dict[tuple[str, str], int] = {}
   263	        for cell in grade_cells:
   264	            groups[(cell.baseline, cell.site)] = groups.get((cell.baseline, cell.site), 0) + 1
   265	        detail = ", ".join(f"{baseline} {site}={count}" for (baseline, site), count in sorted(groups.items()))
   266	        label = grade
   267	        lines.append(f"{label}: {len(grade_cells)} ({detail})")
   268	    return "\n".join(lines)
   269	
   270	
   271	def main() -> int:
   272	    parser = argparse.ArgumentParser(description="Inspect the analysis run registry")
   273	    parser.add_argument("--report", action="store_true", help="Print cell coverage report")
   274	    args = parser.parse_args()
   275	    if args.report:
   276	        print(_report())
   277	    else:
   278	        cells = get_all_cells()
   279	        print(f"{len(cells)} cells loaded")
   280	    return 0

