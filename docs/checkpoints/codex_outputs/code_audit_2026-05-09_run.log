    52	def holm_correct(pvals: list[float]) -> list[tuple[float, bool]]:
    53	    """Holm-Bonferroni step-down. Input p-values, output (adj_p, reject@0.05)."""
    54	    n = len(pvals)
    55	    order = sorted(range(n), key=lambda i: pvals[i])
    56	    adj = [0.0] * n
    57	    reject = [False] * n
