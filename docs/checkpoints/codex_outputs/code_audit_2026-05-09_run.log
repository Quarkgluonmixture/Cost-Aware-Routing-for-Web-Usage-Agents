   103	def bootstrap_lift_ci(in_3: np.ndarray, in_5: np.ndarray, B: int = 1000, seed: int = 42
   104	                      ) -> tuple[float, float]:
   105	    """Bootstrap 95% CI on (5-mode oracle SR - 3-mode oracle SR)."""
   106	    n = len(in_3)
   107	    rng = np.random.default_rng(seed)
   108	    lifts = np.empty(B)
   109	    for b in range(B):
   110	        idx = rng.integers(0, n, size=n)
   111	        lifts[b] = 100 * (int(in_5[idx].sum()) - int(in_3[idx].sum())) / n
   112	    return float(np.quantile(lifts, 0.025)), float(np.quantile(lifts, 0.975))
   113	
   114	
   115	def cohen_h(p1: float, p2: float) -> float:
   116	    """Cohen's h effect size between two proportions p1, p2 ∈ [0, 1].
   117	
   118	    h = 2 * (arcsin(√p1) - arcsin(√p2))
   119	
   120	    Interpretation: |h|<0.2 small, 0.2-0.5 medium, 0.5-0.8 large, >0.8 huge.
   121	    Sign indicates direction (p1 > p2 → h > 0).
   122	    """
   123	    p1 = max(0.0, min(1.0, p1))
   124	    p2 = max(0.0, min(1.0, p2))
   125	    return 2 * (math.asin(math.sqrt(p1)) - math.asin(math.sqrt(p2)))
   126	
   127	
   128	def cohen_h_label(h: float) -> str:
   129	    a = abs(h)
   130	    if a < 0.2:
   131	        return "small"
   132	    if a < 0.5:
   133	        return "medium"
   134	    if a < 0.8:
   135	        return "large"
   136	    return "huge"
   137	
   138	
   139	def wilcoxon_signed_rank(in_a: np.ndarray, in_b: np.ndarray) -> tuple[Optional[float], Optional[float]]:
   140	    """Wilcoxon signed-rank test on paired binary task outcomes (a vs b).
   141	
   142	    For binary outcomes diff ∈ {-1, 0, +1}; scipy drops zero diffs. When set b
   143	    ⊇ set a (e.g. 5-mode oracle ⊇ 3-mode oracle), all non-zero diffs are
   144	    positive (b solves task that a doesn't) → test reduces to one-sided
   145	    binomial (sign test). Returns (statistic, p_two_sided) or (None, None) if
   146	    scipy unavailable / undefined.
   147	    """
   148	    if not HAS_SCIPY:
   149	        return None, None
   150	    diffs = in_b.astype(int) - in_a.astype(int)
   151	    nonzero = diffs[diffs != 0]
   152	    if len(nonzero) == 0:
   153	        return None, 1.0  # no difference, p = 1
   154	    try:
   155	        with warnings.catch_warnings():
   156	            warnings.simplefilter("ignore")
   157	            stat, p = sp_stats.wilcoxon(diffs, zero_method="wilcox", alternative="two-sided")
   158	        return float(stat), float(p)
   159	    except Exception:
   160	        return None, None
   161	
   162	
   163	def mcnemar_exact_one_sided(in_a: np.ndarray, in_b: np.ndarray) -> Optional[float]:
   164	    """McNemar exact one-sided p-value: H1 = b > a (b adds tasks a misses).
   165	
   166	    For monotonic case (b ⊇ a), discordant b-only count = sum(b - a > 0),
   167	    a-only count = 0. Exact binomial: p = 0.5^(b_only).
   168	    """
   169	    if not HAS_SCIPY:
   170	        return None
   171	    a = in_a.astype(int); b = in_b.astype(int)
   172	    a_only = int(((a > b)).sum())
   173	    b_only = int(((b > a)).sum())
   174	    n_disc = a_only + b_only
   175	    if n_disc == 0:
   176	        return 1.0
   177	    # one-sided: H1 = b > a
   178	    return float(sp_stats.binom.cdf(a_only, n_disc, 0.5))
   179	
   180	
   181	def bootstrap_unique_count_ci(in_a: np.ndarray, in_b: np.ndarray,
   182	                              B: int = 1000, seed: int = 42, ci: float = 0.95
   183	                              ) -> tuple[int, float, float]:
   184	    """Bootstrap CI on |a ∖ b| count: tasks where a solves but b doesn't.
   185	
   186	    H3 structural claim test: arm a contributes tasks NOT solved by arm b.
   187	    If lower CI bound > 0, "a has unique non-overlap with b" sig at 1-ci level.
   188	
   189	    Used per-cell for:
   190	      P-text ∖ P-SoM unique count (axis 1 structural evidence)
   191	      P-prompt ∖ P-SoM unique count (axis 2 structural evidence)
   192	    """
   193	    n = len(in_a)
   194	    if n == 0 or len(in_b) != n:
   195	        return 0, 0.0, 0.0
   196	    a = in_a.astype(bool)
   197	    b = in_b.astype(bool)
   198	    observed = int((a & ~b).sum())
   199	    rng = np.random.default_rng(seed)
   200	    counts = np.empty(B)
   201	    for r in range(B):
   202	        idx = rng.integers(0, n, size=n)
   203	        counts[r] = int((a[idx] & ~b[idx]).sum())
   204	    alpha = (1 - ci) / 2
   205	    return observed, float(np.quantile(counts, alpha)), float(np.quantile(counts, 1 - alpha))
   206	
   207	
   208	def bootstrap_tost_p(in_a: np.ndarray, in_b: np.ndarray,
   209	                     delta_pp: float = 0.5, B: int = 1000, seed: int = 42
   210	                     ) -> Optional[float]:
   211	    """Bootstrap TOST (Two One-Sided Tests) p-value for paired binary lift.
   212	
   213	    H0_lower: lift ≤ -δ   →   reject if bootstrap dist mostly above -δ
   214	    H0_upper: lift ≥ +δ   →   reject if bootstrap dist mostly below +δ
   215	    TOST p = max(p_lower, p_upper). If max < α, equivalence at margin δ rejected
   216	    (effect is *practically nonzero* relative to δ).
   217	
   218	    For phantom_lift, δ defaults to 0.5pp (≈ 1 task in N=234), which is the
   219	    paper's pre-registered minimum-meaningful magnitude.
   220	    """
   221	    if len(in_a) != len(in_b):
   222	        return None
   223	    n = len(in_a)
   224	    if n == 0:
   225	        return None
   226	    rng = np.random.default_rng(seed)
   227	    lifts = np.empty(B)
   228	    for b in range(B):
   229	        idx = rng.integers(0, n, size=n)
   230	        lifts[b] = 100 * (int(in_b[idx].sum()) - int(in_a[idx].sum())) / n
   231	    p_lower = float(np.mean(lifts <= -delta_pp))
   232	    p_upper = float(np.mean(lifts >= delta_pp))
   233	    return max(p_lower, p_upper)
   234	
