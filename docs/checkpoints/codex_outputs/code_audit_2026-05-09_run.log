    28	
    29	def _action_signature(action: Dict[str, Any]) -> str:
    30	    """Compact fingerprint of an action for cycle detection (strict: includes element_id)."""
    31	    atype = str(action.get("action_type", "")).lower()
    32	    eid = action.get("element_id", "")
    33	    text = str(action.get("text", ""))[:60]
    34	    coord = action.get("coordinate", "")
    35	    delta = action.get("delta", "")
    36	    # tab_focus: include page_number so switching between different tabs is not
    37	    # mistakenly treated as a cycle (e.g. 1→0→1 differs from 1→1→1).
    38	    page_num = action.get("page_number", "") if atype == "tab_focus" else ""
    39	    return f"{atype}|eid={eid}|t={text}|c={coord}|d={delta}|pn={page_num}"
    40	
    41	
    42	def _action_signature_soft(action: Dict[str, Any]) -> str:
    43	    """Loose fingerprint ignoring element_id/coordinate (catches semantic loops
    44	    where the same search query or click-type is repeated on re-rendered pages)."""
    45	    atype = str(action.get("action_type", "")).lower()
    46	    text = str(action.get("text", ""))[:60]
    47	    delta = action.get("delta", "")
    48	    # tab_focus: include page_number in soft signature for the same reason.
    49	    page_num = action.get("page_number", "") if atype == "tab_focus" else ""
    50	    return f"{atype}|t={text}|d={delta}|pn={page_num}"
    51	
    52	
    53	def _action_signature_fuzzy(action: Dict[str, Any], obs_url: str = "") -> str:
    54	    """Fuzzy fingerprint ignoring element_id/coordinate/text — catches semantic
    55	    loops where agent varies query/target slightly but stays on same URL doing
    56	    same action_type (B-11 search-loop with rephrased queries, B-17 repeat
    57	    click-on-link, B-18 click-truncate-at-max-step).
    58	
    59	    Uses (action_type, url_path_no_query) — max-aggressive fuzzy. Higher
    60	    min_reps required at cycle-detect call site (5 instead of 3-4) to keep
    61	    false-positive rate acceptable.
    62	    """
    63	    atype = str(action.get("action_type", "")).lower()
    64	    # Strip query string from URL (search-loop varies query=foo&query=bar but
    65	    # URL path stays /index.php). Also strip fragment.
    66	    url = str(obs_url or "")
    67	    url_path = url.split("?", 1)[0].split("#", 1)[0]
    68	    # tab_focus: include page_number so different tab orchestration doesn't
    69	    # collapse into one fuzzy bucket.
    70	    page_num = action.get("page_number", "") if atype == "tab_focus" else ""
    71	    return f"{atype}|u={url_path}|pn={page_num}"
    72	
    73	
    74	def _detect_action_cycle(signatures: List[str], min_cycle: int = 1, max_cycle: int = 4,
    75	                         min_reps: int = 3) -> int:
    76	    """Return cycle length if the tail of *signatures* is a repeating cycle, else 0.
    77	
    78	    Requires at least *min_reps* full repetitions of the cycle to trigger.
    79	    E.g. [A,B,A,B,A,B] → cycle_len=2.  [A,A,A] → cycle_len=1.
    80	    """
    81	    n = len(signatures)
    82	    for clen in range(min_cycle, max_cycle + 1):
    83	        window = clen * min_reps
    84	        if n < window:
    85	            continue
    86	        tail = signatures[-window:]
    87	        pattern = tail[:clen]
    88	        if all(tail[i] == pattern[i % clen] for i in range(window)):
    89	            return clen
    90	    return 0
    91	
