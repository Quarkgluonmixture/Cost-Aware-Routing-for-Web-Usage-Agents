   154	def cross_direction_test(
   155	    fwd_per_task: list[dict],
   156	    rev_per_task: list[dict],
   157	    layer: int = 17,
   158	    metric: str = "token_overlap_to_target",
   159	) -> dict:
   160	    """Welch's t-test: are forward and reverse disruption magnitudes equal at layer L?
   161	
   162	    Test H0: mean(fwd L_n - L_35) == mean(rev L_n - L_35).
   163	    """
   164	    fwd_grid = extract_metric_grid(fwd_per_task, metric)
   165	    rev_grid = extract_metric_grid(rev_per_task, metric)
   166	    fwd_diff = fwd_grid[:, layer] - fwd_grid[:, BASELINE_LAYER]
   167	    rev_diff = rev_grid[:, layer] - rev_grid[:, BASELINE_LAYER]
   168	
   169	    t_stat, t_p_two = stats.ttest_ind(fwd_diff, rev_diff, equal_var=False)
   170	
   171	    return {
   172	        "layer": layer,
   173	        "metric": metric,
   174	        "fwd_n": int(fwd_grid.shape[0]),
   175	        "rev_n": int(rev_grid.shape[0]),
   176	        "fwd_mean_diff": float(fwd_diff.mean()),
   177	        "fwd_std_diff": float(fwd_diff.std(ddof=1)),
   178	        "rev_mean_diff": float(rev_diff.mean()),
   179	        "rev_std_diff": float(rev_diff.std(ddof=1)),
   180	        "welch_t": float(t_stat),
   181	        "welch_p_two_sided": float(t_p_two),
   182	    }
