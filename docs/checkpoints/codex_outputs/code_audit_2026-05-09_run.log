   265	def wilcoxon_signed_rank_p(diffs: list[float]) -> float:
   266	    """Two-sided Wilcoxon signed-rank p-value, excluding zero differences.
   267	
   268	    This mirrors scipy.stats.wilcoxon(..., zero_method="wilcox",
   269	    alternative="two-sided", correction=False) using the normal approximation.
   270	    The task-level N here is large, so exact enumeration is unnecessary.
   271	    """
   272	    nonzero = [diff for diff in diffs if diff != 0]
   273	    n = len(nonzero)
   274	    if n == 0:
   275	        return 1.0
   276	    abs_diffs = [abs(diff) for diff in nonzero]
   277	    ranks = average_ranks(abs_diffs)
   278	    w_plus = sum(rank for rank, diff in zip(ranks, nonzero) if diff > 0)
   279	    mean = n * (n + 1) / 4.0
   280	    var = n * (n + 1) * (2 * n + 1) / 24.0
   281	    tie_counts: dict[float, int] = {}
   282	    for value in abs_diffs:
   283	        tie_counts[value] = tie_counts.get(value, 0) + 1
   284	    tie_adjust = sum(count**3 - count for count in tie_counts.values()) / 48.0
   285	    var -= tie_adjust
   286	    if var <= 0:
   287	        return 1.0
   288	    z = (w_plus - mean) / math.sqrt(var)
   289	    return float(math.erfc(abs(z) / math.sqrt(2.0)))
