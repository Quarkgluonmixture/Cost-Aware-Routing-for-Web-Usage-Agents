    40	            ref = t.get("eval", {}).get("reference_answers", {})
    41	            if isinstance(ref, dict) and ref.get("fuzzy_match") == "N/A":
    42	                na_ids.add(t["task_id"])
    43	        return na_ids
    44	    except Exception as exc:
    45	        logger.warning(
