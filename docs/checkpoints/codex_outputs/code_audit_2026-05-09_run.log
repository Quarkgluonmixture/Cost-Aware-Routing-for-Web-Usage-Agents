   271	def _levenshtein_token(a, b) -> int:
   272	    """Token-level edit distance between two integer sequences (DP, no extra dep)."""
   273	    if not a:
   274	        return len(b)
   275	    if not b:
   276	        return len(a)
   277	    m, n = len(a), len(b)
   278	    prev = list(range(n + 1))
   279	    for i in range(1, m + 1):
   280	        curr = [i] + [0] * n
   281	        for j in range(1, n + 1):
   282	            cost = 0 if a[i - 1] == b[j - 1] else 1
   283	            curr[j] = min(curr[j - 1] + 1, prev[j] + 1, prev[j - 1] + cost)
   284	        prev = curr
   285	    return prev[n]
