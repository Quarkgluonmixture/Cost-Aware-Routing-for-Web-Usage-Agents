   128	def _compute_pareto_front(points: List[Dict[str, float]], maximize: str, minimize: str) -> List[int]:
   129	    """Return indices of Pareto-optimal points (maximize one axis, minimize another).
   130	
   131	    Sweep order: by `maximize` desc, then `minimize` asc. A point joins the
   132	    front only when its `minimize` is strictly less than the running best —
   133	    `<=` would let dominated points (same minimize, lower maximize) sneak in.
   134	    """
   135	    indexed = list(enumerate(points))
   136	    indexed.sort(key=lambda x: (-x[1].get(maximize, 0.0), x[1].get(minimize, 0.0)))
   137	    pareto_indices: List[int] = []
   138	    best_min = float("inf")
   139	    for idx, pt in indexed:
   140	        val = pt.get(minimize, float("inf"))
   141	        if val < best_min:
   142	            pareto_indices.append(idx)
   143	            best_min = val
   144	    pareto_indices.sort(key=lambda i: points[i].get(minimize, 0.0))
   145	    return pareto_indices
