   833	def _compute_statistical_tests(
   834	    cond_df,
   835	    ep_df,
   836	    reports_dir: Path,
   837	    tables_dir: Path,
   838	) -> None:
   839	    """Compute bootstrap CIs, McNemar's test, and Wilcoxon signed-rank tests."""
   840	    try:
   841	        import numpy as np  # type: ignore
   842	        import pandas as pd  # type: ignore
   843	        from scipy import stats as scipy_stats  # type: ignore
   844	    except ImportError:
   845	        logger.warning("numpy/pandas/scipy not installed; skipping statistical tests")
   846	        return
   847	
   848	    if ep_df.empty or "condition_id" not in ep_df.columns:
   849	        return
   850	
   851	    cond_ids = cond_df["condition_id"].tolist() if not cond_df.empty and "condition_id" in cond_df.columns else ep_df["condition_id"].unique().tolist()
   852	    results: Dict[str, Any] = {"bootstrap_ci": {}, "mcnemar": {}, "wilcoxon": {}, "notes": []}
   853	    flat_rows: List[Dict[str, Any]] = []
   854	
   855	    rng = np.random.default_rng(42)
   856	    n_boot = 10_000
   857	
   858	    # a) Bootstrap 95% CI per condition
   859	    for cid in cond_ids:
   860	        mask = ep_df["condition_id"] == cid
   861	        sub = ep_df[mask]
   862	        if sub.empty or "success" not in sub.columns:
   863	            continue
   864	        successes = sub["success"].astype(float).fillna(0).values
   865	        boot_means = [rng.choice(successes, size=len(successes), replace=True).mean() for _ in range(n_boot)]
   866	        ci_lo = float(np.percentile(boot_means, 2.5))
   867	        ci_hi = float(np.percentile(boot_means, 97.5))
   868	        results["bootstrap_ci"][cid] = {
   869	            "success_rate": float(successes.mean()),
   870	            "ci_lower_95": ci_lo,
   871	            "ci_upper_95": ci_hi,
   872	            "n_episodes": int(len(successes)),
   873	        }
   874	        flat_rows.append({
   875	            "comparison": cid,
   876	            "metric": "success_rate",
   877	            "test": "bootstrap_ci",
   878	            "statistic": float(successes.mean()),
   879	            "p_value": None,
   880	            "significant_05": None,
   881	            "ci_lower": ci_lo,
   882	            "ci_upper": ci_hi,
   883	        })
   884	
   885	    # b) McNemar's exact test and c) Wilcoxon signed-rank (per condition-pair)
   886	    if len(cond_ids) >= 2 and "task_id" in ep_df.columns:
   887	        for i in range(len(cond_ids)):
   888	            for j in range(i + 1, len(cond_ids)):
   889	                cid_a, cid_b = cond_ids[i], cond_ids[j]
   890	                df_a = ep_df[ep_df["condition_id"] == cid_a][["task_id", "success", "total_cost_usd", "p95_step_latency_ms"]].copy()
   891	                df_b = ep_df[ep_df["condition_id"] == cid_b][["task_id", "success", "total_cost_usd", "p95_step_latency_ms"]].copy()
   892	                merged = df_a.merge(df_b, on="task_id", suffixes=("_a", "_b"))
   893	                if merged.empty:
   894	                    results["notes"].append(f"No paired tasks for {cid_a} vs {cid_b}")
   895	                    continue
   896	
   897	                pair_key = f"{cid_a}_vs_{cid_b}"
   898	
   899	                # McNemar
   900	                if {"success_a", "success_b"}.issubset(merged.columns):
   901	                    try:
   902	                        a_succ = merged["success_a"].astype(float).fillna(0).astype(bool)
   903	                        b_succ = merged["success_b"].astype(float).fillna(0).astype(bool)
   904	                        n00 = int((~a_succ & ~b_succ).sum())
   905	                        n01 = int((~a_succ & b_succ).sum())
   906	                        n10 = int((a_succ & ~b_succ).sum())
   907	                        n11 = int((a_succ & b_succ).sum())
   908	                        # McNemar exact test via binomial (scipy has no mcnemar)
   909	                        n_discordant = n01 + n10
   910	                        stat = float(min(n01, n10))
   911	                        if n_discordant == 0:
   912	                            p_val = 1.0
   913	                        else:
   914	                            from scipy.stats import binomtest
   915	                            bres = binomtest(n10, n_discordant, 0.5, alternative='two-sided')
   916	                            p_val = float(bres.pvalue)
   917	                        results["mcnemar"][pair_key] = {
   918	                            "statistic": stat,
   919	                            "p_value": p_val,
   920	                            "significant_05": p_val < 0.05,
   921	                            "contingency": {"n11": n11, "n10": n10, "n01": n01, "n00": n00},
   922	                        }
   923	                        flat_rows.append({
   924	                            "comparison": pair_key,
   925	                            "metric": "success",
   926	                            "test": "mcnemar_exact",
   927	                            "statistic": stat,
   928	                            "p_value": p_val,
   929	                            "significant_05": p_val < 0.05,
   930	                            "ci_lower": None,
   931	                            "ci_upper": None,
   932	                        })
   933	                    except Exception as exc:
   934	                        results["notes"].append(f"McNemar failed for {pair_key}: {exc}")
   935	
   936	                # Wilcoxon for cost and latency
   937	                for metric, col_a, col_b in [
   938	                    ("total_cost_usd", "total_cost_usd_a", "total_cost_usd_b"),
   939	                    ("p95_step_latency_ms", "p95_step_latency_ms_a", "p95_step_latency_ms_b"),
