   227	        out = subprocess.run(
   228	            ["pgrep", "-af", "run_experiment"],
   229	            capture_output=True, text=True, timeout=5,
   230	        )
   231	    except Exception:
   232	        return None
   233	    for line in out.stdout.splitlines():
   234	        if run_id and run_id in line:
   235	            try:
