   263	def _token_seq_overlap(seq_a, seq_b) -> float:
   264	    """Ratio of positions where seq_a[i] == seq_b[i] (prefix-aligned). 1.0 = identical."""
   265	    n = min(len(seq_a), len(seq_b))
   266	    if n == 0:
   267	        return 0.0
   268	    return sum(int(seq_a[i] == seq_b[i]) for i in range(n)) / n
