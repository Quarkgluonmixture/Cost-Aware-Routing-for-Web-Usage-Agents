    42	def extract_metric_grid(per_task: list[dict], metric: str) -> np.ndarray:
    43	    """Return shape (n_tasks, n_layers) ndarray for a given metric.
    44	    metric ∈ {token_overlap_to_source, token_overlap_to_target, ld_to_source, ld_to_target}.
    45	    """
