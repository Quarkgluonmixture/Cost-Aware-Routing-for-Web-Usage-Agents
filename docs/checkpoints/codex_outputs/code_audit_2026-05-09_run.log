   220	def detect_pid(run_id: str) -> Optional[int]:
   221	    """Try to recover PID for a re-run by pgrep matching condition run_id segment.
   222	
   223	    On re-run, runner spawns a new process whose argv contains the run dir name
   224	    (or a config that resolves to it). Best-effort match; returns None if unsure.
   225	    """
