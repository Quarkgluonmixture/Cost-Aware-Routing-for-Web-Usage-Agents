   155	def bootstrap_drop_one_ci(
   156	    sets: dict[str, set[int]],
   157	    expected: int,
   158	    n_bootstrap: int = 1000,
   159	    seed: int = 42,
   160	    ci: float = 0.95,
   161	) -> dict[str, tuple[float, float]]:
   162	    """Bootstrap 95% CI for drop-one oracle loss per mode.
   163	
   164	    Resamples N tasks (with replacement) from observed task universe; for each
   165	    resample, recomputes drop-one loss; returns (low, high) percentiles.
   166	    """
   167	    rng = np.random.default_rng(seed)
   168	    if not sets:
   169	        return {}
   170	    universe = sorted(set().union(*sets.values()))
   171	    if not universe:
   172	        return {mode: (0.0, 0.0) for mode in sets}
   173	    n = len(universe)
   174	    arr = np.asarray(universe)
   175	    # Pre-build per-mode boolean masks indexed by universe order
   176	    mode_masks = {mode: np.isin(arr, list(s)) for mode, s in sets.items()}
   177	    losses_samples = {mode: np.empty(n_bootstrap) for mode in sets}
   178	    for b in range(n_bootstrap):
   179	        idx = rng.integers(0, n, size=n)
   180	        union_succ = np.zeros(n, dtype=bool)
   181	        for mask in mode_masks.values():
   182	            union_succ |= mask[idx]
   183	        union_count = int(union_succ.sum())
   184	        for mode, mask in mode_masks.items():
   185	            without = np.zeros(n, dtype=bool)
   186	            for m, mk in mode_masks.items():
   187	                if m == mode:
   188	                    continue
   189	                without |= mk[idx]
   190	            losses_samples[mode][b] = 100.0 * (union_count - int(without.sum())) / expected
   191	    alpha = (1 - ci) / 2
   192	    return {
   193	        mode: (
   194	            float(np.quantile(samples, alpha)),
   195	            float(np.quantile(samples, 1 - alpha)),
   196	        )
   197	        for mode, samples in losses_samples.items()
   198	    }
