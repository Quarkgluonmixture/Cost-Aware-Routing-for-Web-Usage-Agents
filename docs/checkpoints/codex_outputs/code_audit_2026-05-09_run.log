   106	def find_matching_runs(baseline: str, site: str, mode: str, benchmark: str = "vwa") -> list[dict]:
   107	    """Find run condition dirs matching (baseline, site, mode, benchmark).
   108	
   109	    Site is anchored against `_<site>_<8-digit>` to avoid `shopping` substring
   110	    collision with `shopping_admin` run dirs.
   111	
   112	    Returns list of dicts (one per matched condition dir), each with:
   113	      - cond_dir: Path to condition directory
