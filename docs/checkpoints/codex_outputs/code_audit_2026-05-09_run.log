   135	        if not run_dir.name.startswith(baseline + "_"):
   136	            continue
   137	        if not site_pat.search(run_dir.name):
   138	            continue
   139	        for cond_dir in run_dir.iterdir():
   140	            if not cond_dir.is_dir():
