    60	        adj[i] = min(1.0, max(prev_adj, pvals[i] * (n - rank)))
    61	        prev_adj = adj[i]
    62	        reject[i] = adj[i] < 0.05
    63	    # Once a rejection is rejected, all weaker p-values cannot reject either
    64	    rejected_so_far = True
    65	    for i in order:
    66	        if not reject[i]:
    67	            rejected_so_far = False
    68	        if not rejected_so_far:
    69	            reject[i] = False
    70	    return [(adj[i], reject[i]) for i in range(n)]
