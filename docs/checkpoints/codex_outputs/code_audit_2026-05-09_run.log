    46	def dl_random_effects(estimates: list[float], variances: list[float]) -> dict:
    47	    """DerSimonian-Laird random-effects meta-analysis on per-cell estimates.
    48	
    49	    Returns dict with theta_re, se_re, ci_lo, ci_hi, z, p_one_sided, tau2, I2, Q, df.
    50	    """
    51	    k = len(estimates)
    52	    if k == 0:
    53	        return {"k": 0}
    54	
    55	    weights_fe = [1.0 / v if v > 0 else 0.0 for v in variances]
    56	    sum_w = sum(weights_fe)
    57	    theta_fe = sum(w * t for w, t in zip(weights_fe, estimates)) / sum_w
    58	    Q = sum(w * (t - theta_fe) ** 2 for w, t in zip(weights_fe, estimates))
    59	    df = k - 1
    60	    sum_w_sq = sum(w ** 2 for w in weights_fe)
    61	    if df > 0:
    62	        c = sum_w - sum_w_sq / sum_w
    63	        tau2 = max(0.0, (Q - df) / c) if c > 0 else 0.0
    64	    else:
    65	        tau2 = 0.0
    66	    weights_re = [1.0 / (v + tau2) if (v + tau2) > 0 else 0.0 for v in variances]
    67	    sum_w_re = sum(weights_re)
    68	    theta_re = sum(w * t for w, t in zip(weights_re, estimates)) / sum_w_re
    69	    se_re = math.sqrt(1.0 / sum_w_re) if sum_w_re > 0 else float("nan")
    70	    ci_lo = theta_re - 1.96 * se_re
    71	    ci_hi = theta_re + 1.96 * se_re
    72	    z = theta_re / se_re if se_re > 0 else float("nan")
    73	    # one-sided p (H1: theta_re > 0)
    74	    from math import erf
    75	    def phi(z):
    76	        return 0.5 * (1 + erf(z / math.sqrt(2)))
    77	    p_one_sided = 1 - phi(z) if not math.isnan(z) else float("nan")
    78	    I2 = max(0.0, (Q - df) / Q * 100) if Q > 0 and df > 0 else 0.0
    79	    return dict(
    80	        k=k, theta_re=theta_re, se_re=se_re, ci_lo=ci_lo, ci_hi=ci_hi,
    81	        z=z, p_one_sided=p_one_sided, tau2=tau2, I2=I2, Q=Q, df=df,
    82	    )
    83	
