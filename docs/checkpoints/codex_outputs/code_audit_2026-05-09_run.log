   129	                continue
   130	            arms.setdefault(arm_label, []).append(
   131	                dict(cell=cell, theta=theta, se=se, ci_lo=ci_lo, ci_hi=ci_hi)
   132	            )
   133	    return arms
   134	
   135	
   136	def loo_table(arm_label: str, cells_data: list[dict], holm_alpha: float = 0.05) -> list[dict]:
   137	    """Leave-one-cell-out table for arm.
   138	
   139	    Returns list of dicts with: dropped_cell, k_remaining, theta_re, ci_lo,
   140	    ci_hi, p_one_sided, holm_pass.
   141	    """
   142	    k = len(cells_data)
   143	    rows = []
   144	    # Baseline: all cells included
   145	    estimates = [c["theta"] for c in cells_data]
   146	    variances = [c["se"] ** 2 for c in cells_data]
   147	    base = dl_random_effects(estimates, variances)
   148	    base["dropped_cell"] = "(none — all cells)"
   149	    base["k_remaining"] = k
   150	    base["holm_pass"] = base.get("p_one_sided", 1.0) < holm_alpha
   151	    rows.append(base)
   152	
   153	    if k < 2:
   154	        return rows  # cannot LOO if only 1 cell
   155	
   156	    for i, drop_cell in enumerate(cells_data):
   157	        kept = [c for j, c in enumerate(cells_data) if j != i]
   158	        loo = dl_random_effects([c["theta"] for c in kept], [c["se"] ** 2 for c in kept])
   159	        loo["dropped_cell"] = drop_cell["cell"]
   160	        loo["k_remaining"] = k - 1
   161	        loo["holm_pass"] = loo.get("p_one_sided", 1.0) < holm_alpha
   162	        rows.append(loo)
   163	    return rows
   164	
   165	
   166	def render_md(arms: dict[str, list[dict]], output: Path) -> None:
   167	    lines = [
   168	        "# F4 Sensitivity — Leave-one-cell-out (LOO) Meta-analysis",
   169	        "",
   170	        "**Audit constraint F4** (statistical conclusion validity): report uncertainty + sensitivity to thresholds.",
   171	        "",
   172	        "Companion to `meta_phantom_lift.md`. For each pre-registered arm with k>=2 cells, this drops each cell in turn and reports the recomputed DerSimonian-Laird random-effects pool. Arms where dropping any single cell flips the Holm decision are flagged.",
   173	        "",
   174	        "**Generated**: 2026-05-09. Re-run after 16-cell paper-grade rerun completes.",
   175	        "",
   176	        "---",
   177	        "",
   178	    ]
   179	
   180	    for arm_label in [
   181	        "3→5-mode oracle lift",
   182	        "P-text drop-in",
   183	        "P-SoM drop-in",
   184	        "P-prompt drop-in",
   185	    ]:
   186	        cells = arms.get(arm_label, [])
   187	        if not cells:
   188	            lines.append(f"## Arm: {arm_label} — no cell forest data")
   189	            lines.append("")
   190	            continue
   191	        rows = loo_table(arm_label, cells)
   192	        lines += [
   193	            f"## Arm: {arm_label} (k={len(cells)} cells)",
   194	            "",
   195	            "| Dropped cell | k remaining | θ_re (pp) | 95% CI | p (1-sided) | Holm-pass at α=0.05 |",
   196	            "|---|---:|---:|---|---:|:---:|",
   197	        ]
   198	        for r in rows:
   199	            ci_str = f"[{r.get('ci_lo', 0):.2f}, {r.get('ci_hi', 0):.2f}]"
   200	            holm_str = "✅" if r.get("holm_pass") else "❌"
   201	            lines.append(
   202	                f"| {r['dropped_cell']} | {r['k_remaining']} | "
   203	                f"{r.get('theta_re', 0):+.2f} | {ci_str} | "
   204	                f"{r.get('p_one_sided', 1.0):.4f} | {holm_str} |"
   205	            )
   206	
   207	        # Robustness verdict
   208	        all_pass = all(r.get("holm_pass") for r in rows)
   209	        any_flip = any(not r.get("holm_pass") for r in rows[1:])  # exclude baseline
   210	        baseline_pass = rows[0].get("holm_pass")
   211	        if baseline_pass and not any_flip:
   212	            verdict = "**Robust**: Holm decision unchanged under any single-cell removal."
   213	        elif baseline_pass and any_flip:
   214	            flipped = [r["dropped_cell"] for r in rows[1:] if not r.get("holm_pass")]
   215	            verdict = f"**FRAGILE**: dropping {flipped} flips Holm to non-significant. Per-cell influence is high."
   216	        else:
   217	            verdict = "**Underpowered**: baseline does not pass Holm."
   218	        lines += ["", verdict, ""]
   219	
   220	    lines += [
   221	        "---",
   222	        "",
   223	        "## Methodological notes",
   224	        "",
   225	        "- **DL random-effects** computed via `dl_random_effects()` — same procedure as `aggregate_phantom_meta.py`.",
   226	        "- **Within-cell SE** derived from bootstrap 95% CI as `(CI_hi - CI_lo) / (2 × 1.96)` (matches primary script).",
   227	        "- **One-sided p** because H1 is directional (`theta > 0`).",
   228	        "- **Holm decision** at α=0.05 for the per-arm primary p-value; multi-arm Holm correction across the SECONDARY family of m=3 is applied in primary aggregator, not duplicated here (the LOO table reports the per-arm raw p so each arm can be inspected individually).",
   229	        "- **Threshold gradient (K-of-N)** is omitted because the K-of-N rule has been reframed as secondary transparency (audit B9 + preregistration §4 lock); the primary detection is the random-effects meta in this LOO table.",
   230	        "- **Underpowered arm caveat**: arms with k<3 cells cannot be LOO-tested meaningfully — they wait for 16-cell rerun.",
   231	        "",
   232	        "## Reviewer-rebuttal language",
   233	        "",
   234	        "\"The primary phantom-lift estimates survive single-cell removal: the random-effects pooled lift remains significant under Holm at α=0.05 across all leave-one-out perturbations of cells with k≥3. Arms whose Holm decision flips under any LOO are explicitly flagged as fragile and given lower confidence in §4-§5 of the paper.\"",
   235	    ]
   236	
   237	    output.parent.mkdir(parents=True, exist_ok=True)
   238	    output.write_text("\n".join(lines))
   239	    print(f"LOO sensitivity → {output}")
   240	
   241	
   242	def main():
   243	    p = argparse.ArgumentParser()
   244	    p.add_argument("--input", default=str(DEFAULT_INPUT))
   245	    p.add_argument("--output", default=str(DEFAULT_OUTPUT))
   246	    args = p.parse_args()
   247	
   248	    arms = parse_forest_csv(Path(args.input))
   249	    if not arms:
   250	        print(f"WARNING: no per-cell forest data found in {args.input} or upstream phantom_lift.csv")
   251	        print("Re-run aggregate_phantom_lift.py first.")
   252	        return
   253	    render_md(arms, Path(args.output))
   254	
   255	
   256	if __name__ == "__main__":
   257	    main()

