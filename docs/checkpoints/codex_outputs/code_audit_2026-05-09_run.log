    30	def mde_paired_binary(n: int, baseline_sr: float, alpha: float = 0.05, beta: float = 0.20) -> float:
    31	    """Minimum detectable effect (in proportion units) for paired binary
    32	    comparison at given N, baseline SR, α, β.
    33	
    34	    Uses McNemar-equivalent normal approximation:
    35	        MDE ≈ (z_{1-α/2} + z_{1-β}) × sqrt(2 × p_avg × (1-p_avg) / n) / sqrt(2)
    36	    where p_avg ≈ baseline_sr (paired tasks share most variance).
    37	
    38	    Returns MDE in proportion units (multiply by 100 for percentage points).
    39	    """
    40	    # Standard normal critical values
    41	    z_alpha = 1.96   # two-sided α=0.05
    42	    z_beta = 0.842   # one-sided β=0.20 → 80% power
    43	    p = baseline_sr
    44	    se_paired = math.sqrt(2 * p * (1 - p) / n)
    45	    mde = (z_alpha + z_beta) * se_paired / math.sqrt(2)
    46	    return mde
    47	
    48	
    49	def k_of_n_power(n_cells: int, k_threshold: int, per_cell_power: float) -> float:
    50	    """Family-wise power for K-of-N pass rule.
    51	
    52	    Each cell test independently has `per_cell_power` probability of detecting
    53	    a true effect. Probability that ≥ k_threshold cells detect = sum of binomial
    54	    PMF from k_threshold to n_cells.
    55	
    56	    Returns family-wise power.
    57	    """
    58	    from math import comb
    59	    p = per_cell_power
    60	    return sum(comb(n_cells, k) * (p ** k) * ((1 - p) ** (n_cells - k))
    61	               for k in range(k_threshold, n_cells + 1))
    62	
    63	
    64	def cohen_h(p1: float, p2: float) -> float:
    65	    """Cohen's h effect size for binary proportions: arcsine transform difference."""
    66	    return 2 * (math.asin(math.sqrt(p1)) - math.asin(math.sqrt(p2)))
    67	
