   247	
   248	def average_ranks(values: list[float]) -> list[float]:
   249	    """Return 1-based average ranks for a numeric vector."""
   250	    order = sorted(range(len(values)), key=values.__getitem__)
   251	    ranks = [0.0] * len(values)
   252	    sorted_values = [values[i] for i in order]
   253	    i = 0
   254	    while i < len(values):
   255	        j = i + 1
   256	        while j < len(values) and sorted_values[j] == sorted_values[i]:
   257	            j += 1
   258	        avg_rank = (i + 1 + j) / 2.0
   259	        for original_idx in order[i:j]:
   260	            ranks[original_idx] = avg_rank
   261	        i = j
   262	    return ranks
