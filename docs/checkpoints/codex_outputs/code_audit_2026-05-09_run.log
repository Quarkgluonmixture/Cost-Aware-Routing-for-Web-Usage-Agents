     2	"""Scan logs/ + logs/cron/ for runner / watchdog / cron errors in last 24h.
     3	
     4	Output JSON to logs/cron/error_scan.json — consumed by glm_playbook_refresh
     5	to populate PLAYBOOK §2.5 "Active errors / warnings".
     6	
     7	Patterns scanned (priority order):
     8	- Python Traceback (most-recent stack)
     9	- NOT_LOGGED_IN / auth_refresh fail (VWA session race)
    10	- CUDA OOM / OutOfMemoryError
    11	- TimeoutError
    12	- ❌ markers (notify_on_fail.sh emits these)
    13	- watchdog ALERT / FAILURE patterns
    14	- HTTP 5xx from proxy API
    15	
    16	Cron @5min via Makefile target `error-scan` (or ad-hoc).
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import argparse
    22	import json
    23	import re
    24	import sys
    25	from datetime import datetime, timedelta, timezone
    26	from pathlib import Path
    27	
    28	REPO = Path(__file__).resolve().parents[3]
    29	LOGS_DIR = REPO / "logs"
    30	CRON_LOGS = REPO / "logs/cron"
    31	OUTPUT = CRON_LOGS / "error_scan.json"
    32	
    33	# Pattern priority — higher = more severe
    34	PATTERNS = [
    35	    ("oom",          re.compile(r"(?:CUDA out of memory|OutOfMemoryError|torch\.cuda\.OutOfMemoryError)", re.IGNORECASE), 90),
    36	    ("traceback",    re.compile(r"^Traceback \(most recent call last\):", re.MULTILINE), 80),
    37	    ("not_logged_in", re.compile(r"NOT[_ ]LOGGED[_ ]IN|auth_refresh.*(?:fail|error)|session.*expired", re.IGNORECASE), 75),
    38	    ("watchdog_alert", re.compile(r"watchdog.*(?:ALERT|FAILURE|abort)", re.IGNORECASE), 70),
    39	    ("notify_fail",  re.compile(r"❌ P79 cron (?:fail|error)|cron failed", re.IGNORECASE), 60),
    40	    ("timeout",      re.compile(r"TimeoutError|asyncio\.TimeoutError|read timed out", re.IGNORECASE), 55),
    41	    ("http5xx",      re.compile(r"HTTPError.*5\d{2}|5\d{2} (?:Server Error|Bad Gateway|Service Unavailable)"), 50),
    42	    ("python_error", re.compile(r"^[A-Z]\w+Error: ", re.MULTILINE), 40),
    43	]
    44	
    45	MAX_TAIL_BYTES = 200_000  # 200KB tail per log
    46	MAX_HITS_PER_FILE = 5
    47	MAX_TOTAL_ERRORS = 50
    48	
    49	
    50	def scan_file(path: Path, cutoff: datetime) -> list[dict]:
    51	    """Return list of {kind, severity, file, line_no, snippet, ts} for recent matches."""
    52	    try:
    53	        mtime = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    54	    except OSError:
    55	        return []
    56	    if mtime < cutoff:
    57	        return []
    58	
    59	    try:
    60	        size = path.stat().st_size
    61	        with path.open("rb") as f:
    62	            if size > MAX_TAIL_BYTES:
    63	                f.seek(-MAX_TAIL_BYTES, 2)
    64	                # discard partial first line
    65	                f.readline()
    66	            text = f.read().decode("utf-8", errors="ignore")
    67	    except OSError:
    68	        return []
    69	
    70	    hits = []
    71	    seen_kinds = {}  # dedup: at most 1 hit per kind per file
    72	    for kind, pat, sev in PATTERNS:
    73	        for m in pat.finditer(text):
    74	            if seen_kinds.get(kind, 0) >= MAX_HITS_PER_FILE // 2:
    75	                break
    76	            # extract context (line containing match + 2 lines after for traceback)
    77	            start = max(0, text.rfind("\n", 0, m.start()) + 1)
    78	            end_lookahead = 3 if kind == "traceback" else 0
    79	            end = m.end()
    80	            for _ in range(end_lookahead):
    81	                nl = text.find("\n", end)
    82	                if nl == -1:
    83	                    break
    84	                end = nl + 1
    85	            snippet = text[start:end].strip().replace("\n", " ⏎ ")[:240]
    86	            line_no = text.count("\n", 0, m.start()) + 1
    87	            hits.append({
    88	                "kind": kind,
    89	                "severity": sev,
    90	                "file": str(path.relative_to(REPO)),
    91	                "mtime": mtime.isoformat(timespec="minutes"),
    92	                "line_no": line_no,
    93	                "snippet": snippet,
    94	            })
    95	            seen_kinds[kind] = seen_kinds.get(kind, 0) + 1
    96	            if len(hits) >= MAX_HITS_PER_FILE:
    97	                return hits
    98	    return hits
    99	
   100	
   101	def main():
   102	    parser = argparse.ArgumentParser()
   103	    parser.add_argument("--hours", type=int, default=24, help="lookback window (default 24h)")
   104	    parser.add_argument("--print", action="store_true", help="print JSON to stdout (default also writes to logs/cron/error_scan.json)")
   105	    args = parser.parse_args()
   106	
   107	    cutoff = datetime.now(timezone.utc) - timedelta(hours=args.hours)
   108	
   109	    # Sources: logs/ top level (runner logs B*_*.log, queue chains), logs/cron/
   110	    candidates = []
   111	    for pattern in ("B0_*.log", "B1_*.log", "queue_*.log", "watchdog_*.log", "phantom_*.log"):
   112	        candidates.extend(LOGS_DIR.glob(pattern))
   113	    candidates.extend(CRON_LOGS.glob("*.log"))
   114	
   115	    all_hits = []
   116	    for f in candidates:
   117	        if not f.is_file():
   118	            continue
   119	        hits = scan_file(f, cutoff)
   120	        all_hits.extend(hits)
   121	        if len(all_hits) >= MAX_TOTAL_ERRORS:
   122	            break
   123	
   124	    # Sort by severity desc, then mtime desc
   125	    all_hits.sort(key=lambda h: (-h["severity"], h["mtime"]), reverse=False)
   126	    all_hits = all_hits[:MAX_TOTAL_ERRORS]
   127	    # Re-sort by mtime desc for output (most recent first)
   128	    all_hits.sort(key=lambda h: h["mtime"], reverse=True)
   129	
   130	    payload = {
   131	        "scanned_at": datetime.now(timezone.utc).isoformat(timespec="minutes"),
   132	        "lookback_hours": args.hours,
   133	        "n_files_scanned": len(candidates),
   134	        "n_errors": len(all_hits),
   135	        "errors": all_hits,
   136	    }
   137	
   138	    OUTPUT.parent.mkdir(parents=True, exist_ok=True)
   139	    OUTPUT.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
   140	
   141	    if args.print:
   142	        print(json.dumps(payload, ensure_ascii=False, indent=2))
   143	    else:
   144	        print(f"📋 Scanned {len(candidates)} files in last {args.hours}h, found {len(all_hits)} errors → {OUTPUT.relative_to(REPO)}")
   145	
   146	    return 0
   147	
   148	
   149	if __name__ == "__main__":
   150	    sys.exit(main())
