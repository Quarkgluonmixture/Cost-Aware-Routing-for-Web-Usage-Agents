    88	def parse_frontmatter(text: str) -> tuple[Optional[dict], str, str]:
    89	    """Returns (fm_dict, fm_raw, body) or (None, '', text) if no frontmatter."""
    90	    m = re.match(r"^---\n(.*?)\n---\n(.*)$", text, re.DOTALL)
