   194	def _file_sha256(path: Path) -> str:
   195	    h = hashlib.sha256()
   196	    with path.open("rb") as f:
   197	        for chunk in iter(lambda: f.read(8192), b""):
   198	            h.update(chunk)
   199	    return h.hexdigest()
