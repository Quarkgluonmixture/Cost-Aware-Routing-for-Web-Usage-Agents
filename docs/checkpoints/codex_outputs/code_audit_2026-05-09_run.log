    93	# ---------------------------------------------------------------------------
    94	# Diagnostic control helpers
    95	# These functions are only active when `diagnostic_controls` is explicitly set
    96	# in the experiment config (diagnostic_controls.enabled: true).  They are
    97	# NOT enabled by default and must NOT be used in main baseline conditions.
    98	# ---------------------------------------------------------------------------
    99	
   100	
   101	def _sanitize_query_text(raw_query: str, max_words: int = 4, suspicious_word_threshold: int = 6) -> str:
   102	    query = re.sub(r"\s+", " ", (raw_query or "").strip())
   103	    if not query:
   104	        return query
   105	
   106	    suspicious = (
   107	        ">" in query
   108	        or "|" in query
   109	        or "/" in query
   110	        or query.count("&") >= 2
   111	        or len(query.split()) >= max(1, suspicious_word_threshold)
   112	    )
   113	    if not suspicious:
   114	        return query
   115	
   116	    parts = [p.strip() for p in re.split(r"\s*(?:>|/|\|)\s*", query) if p.strip()]
   117	    candidate = parts[-1] if parts else query
   118	    candidate = re.sub(r"\([^)]*\)", " ", candidate)
   119	    if "&" in candidate:
   120	        left = candidate.split("&", 1)[0].strip()
   121	        if left:
   122	            candidate = left
   123	    candidate = re.sub(r"[^A-Za-z0-9\-\s]", " ", candidate)
   124	    candidate = re.sub(r"\s+", " ", candidate).strip()
   125	
   126	    words = [w for w in candidate.split() if w]
   127	    if len(words) > max(1, max_words):
   128	        words = words[: max(1, max_words)]
   129	    candidate = " ".join(words).strip()
   130	
   131	    if len(candidate) < 2:
   132	        return query
   133	    return candidate
   134	
   135	
   136	def _query_sanitization_control(action: Dict[str, Any], cfg: Dict[str, Any]) -> Tuple[Dict[str, Any], Optional[str]]:
   137	    if str(action.get("action_type", "")).lower() != "type":
   138	        return action, None
   139	
   140	    text = str(action.get("text", ""))
   141	    had_newline = text.endswith("\n")
   142	    core = text[:-1] if had_newline else text
   143	
   144	    cleaned = _sanitize_query_text(
   145	        raw_query=core,
   146	        max_words=int(cfg.get("max_words", 4)),
   147	        suspicious_word_threshold=int(cfg.get("suspicious_word_threshold", 6)),
   148	    )
   149	    if not cleaned or cleaned == core:
   150	        return action, None
   151	
   152	    patched = dict(action)
   153	    patched["text"] = cleaned + ("\n" if had_newline else "")
   154	    return patched, f"query_sanitized:{core}->{cleaned}"
   155	
   156	
   157	def _repeat_hits_same_target(
   158	    step_records: List[Dict[str, Any]],
   159	    action: Dict[str, Any],
   160	    window: int,
   161	) -> int:
   162	    atype = str(action.get("action_type", "")).lower()
   163	    target_eid = action.get("element_id")
   164	    if atype not in ("click", "type") or target_eid is None or not step_records:
   165	        return 0
   166	
   167	    hits = 0
   168	    for rec in step_records[-max(1, window):]:
   169	        if str(rec.get("action_type", "")).lower() != atype:
   170	            continue
   171	        prev_action = rec.get("action", {}) or {}
   172	        if prev_action.get("element_id") != target_eid:
   173	            continue
   174	        if bool(rec.get("page_changed", True)):
   175	            continue
   176	        hits += 1
   177	    return hits
   178	
   179	
   180	def _build_exploration_fallback_action(
   181	    obs_text: str,
   182	    instruction: str,
   183	    query_cfg: Dict[str, Any],
   184	) -> Dict[str, Any]:
   185	    input_id = first_element_id_by_keyword(obs_text, ("textbox", "input", "search", "edit"))
   186	    query = _sanitize_query_text(
   187	        raw_query=extract_candidate_query(instruction),
   188	        max_words=int(query_cfg.get("max_words", 4)),
   189	        suspicious_word_threshold=int(query_cfg.get("suspicious_word_threshold", 6)),
   190	    )
   191	    if input_id is not None and query:
   192	        return {
   193	            "action_type": "type",
   194	            "element_id": int(input_id),
   195	            "text": f"{query}\n",
   196	            "thought": "Diagnostic control: break loop with reformulated search.",
   197	        }
   198	
   199	    return {
   200	        "action_type": "scroll",
   201	        "delta": [0, 0.8],
   202	        "coordinate_type": "normalized",
   203	        "thought": "Diagnostic control: break loop with forced exploration scroll.",
   204	    }
   205	
   206	
   207	def _anti_repeat_control(
   208	    action: Dict[str, Any],
   209	    step_records: List[Dict[str, Any]],
   210	    obs_text: str,
   211	    instruction: str,
   212	    cfg: Dict[str, Any],
   213	    query_cfg: Dict[str, Any],
   214	) -> Tuple[Dict[str, Any], Optional[str]]:
   215	    if str(action.get("action_type", "")).lower() not in ("click", "type"):
   216	        return action, None
   217	
   218	    window = int(cfg.get("window", 3))
   219	    min_repeat_hits = int(cfg.get("min_repeat_hits", 2))
   220	    hits = _repeat_hits_same_target(step_records, action, window=window)
   221	    if hits < max(1, min_repeat_hits):
   222	        return action, None
   223	
   224	    fallback = _build_exploration_fallback_action(obs_text, instruction, query_cfg=query_cfg)
   225	    return fallback, f"anti_repeat_blocked:hits={hits}"
   226	
   227	
   228	def _no_early_finish_control(
   229	    action: Dict[str, Any],
   230	    step_records: List[Dict[str, Any]],
   231	    obs_text: str,
   232	    instruction: str,
   233	    cfg: Dict[str, Any],
   234	    query_cfg: Dict[str, Any],
   235	) -> Tuple[Dict[str, Any], Optional[str]]:
   236	    atype = str(action.get("action_type", "")).lower()
   237	    if atype not in ("finish", "stop"):
   238	        return action, None
   239	
   240	    min_exploration_steps = int(cfg.get("min_exploration_steps", 5))
   241	    min_page_changes = int(cfg.get("min_page_changes", 2))
   242	    min_search_attempts = int(cfg.get("min_search_attempts", 2))
   243	
   244	    explored_steps = len(step_records)
   245	    page_change_count = sum(1 for s in step_records if bool(s.get("page_changed", False)))
   246	    search_attempts = sum(
   247	        1
   248	        for s in step_records
   249	        if str(s.get("action_type", "")).lower() == "type"
   250	        and bool(str((s.get("action", {}) or {}).get("text", "")).strip())
   251	    )
   252	
   253	    if (
   254	        explored_steps >= min_exploration_steps
   255	        and page_change_count >= min_page_changes
   256	        and search_attempts >= min_search_attempts
   257	    ):
   258	        return action, None
   259	
   260	    fallback = _build_exploration_fallback_action(obs_text, instruction, query_cfg=query_cfg)

