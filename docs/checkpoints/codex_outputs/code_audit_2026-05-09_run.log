    71	def median_energy_kwh(ep_dir: Path, expected: int) -> tuple[float, int]:
    72	    values: list[float] = []
    73	    seen: set[int] = set()
    74	    for path in sorted(ep_dir.glob("*_summary_v2.json")):
    75	        tid = task_id(path)
    76	        if tid in seen:
    77	            continue
    78	        seen.add(tid)
    79	        with path.open() as f:
    80	            record = json.load(f)
    81	        value = record.get("total_energy_kwh")
    82	        if value is not None:
    83	            values.append(float(value))
    84	    if len(seen) != expected:
    85	        print(f"[warn] {ep_dir}: summaries n={len(seen)}/{expected}")
    86	    if len(values) != len(seen):
    87	        print(f"[warn] {ep_dir}: energy n={len(values)}/{len(seen)}")
    88	    if not values:
    89	        raise RuntimeError(f"No total_energy_kwh values under {ep_dir}")
    90	    return statistics.median(values), len(values)
