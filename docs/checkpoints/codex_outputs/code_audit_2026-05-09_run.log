   204	def latest_match(matches: list[dict]) -> Optional[dict]:
   205	    """Pick the most-recent match. Prefer finalized (has summary) over in-flight
   206	    when both exist for same run_id; otherwise pick by recency (mtime of summary
   207	    or cond_dir for in-flight).
   208	    """
   209	    if not matches:
   210	        return None
   211	
   212	    def sort_key(m: dict):
   213	        if m["summary_path"]:
   214	            return (1, m["summary_path"].stat().st_mtime)
   215	        return (0, m["cond_dir"].stat().st_mtime)
   216	
   217	    return max(matches, key=sort_key)
