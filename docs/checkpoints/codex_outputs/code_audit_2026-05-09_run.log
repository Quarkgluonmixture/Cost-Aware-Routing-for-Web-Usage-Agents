    73	def per_direction_layer_test(
    74	    label: str, per_task: list[dict], metric: str = "token_overlap_to_target"
    75	) -> dict:
    76	    """Paired t-test + Wilcoxon for each test-layer vs L35 baseline.
    77	
    78	    Direction convention: H1 = layer disrupts vs baseline. For overlap metrics
    79	    higher means closer to target → disruption is layer < baseline (alternative='less').
    80	    For Levenshtein-distance metrics, lower means closer to target → disruption is
    81	    layer > baseline (alternative='greater'). We auto-detect from metric name.
    82	
    83	    Returns dict with per-layer rows + Holm-adjusted p-values.
    84	    """
    85	    grid = extract_metric_grid(per_task, metric)  # (N, 36)
    86	    n_tasks = grid.shape[0]
    87	    baseline = grid[:, BASELINE_LAYER]
    88	
    89	    # Direction: 'less' for overlap-style, 'greater' for ld-style metrics
    90	    is_distance_metric = metric.startswith("ld_")
    91	    alt_direction = "greater" if is_distance_metric else "less"
    92	
    93	    rng = np.random.default_rng(seed=42)
    94	    n_boot = 10000
    95	
    96	    rows = []
    97	    raw_pvals = []
    98	    for L in TEST_LAYERS:
    99	        layer_vals = grid[:, L]
   100	        diff = layer_vals - baseline
   101	
   102	        # C9 fix: handle constant-column edge case (e.g. cell D L0 has all 1.0
   103	        # → 0 variance → NaN t-stat). Skip test, mark as null.
   104	        if np.std(diff, ddof=1) < 1e-12 if n_tasks > 1 else True:
   105	            t_stat, t_p_one = float("nan"), 1.0
   106	            w_stat, w_p_one = float("nan"), 1.0
   107	            ci_lo, ci_hi = float(diff.mean()), float(diff.mean())
   108	        else:
   109	            # Paired t-test (use scipy's built-in alternative= for clarity)
   110	            t_stat, t_p_one = stats.ttest_rel(layer_vals, baseline, alternative=alt_direction)
   111	
   112	            # Wilcoxon signed-rank (non-parametric backup)
   113	            try:
   114	                w_stat, w_p_one = stats.wilcoxon(layer_vals, baseline,
   115	                                                 zero_method="wilcox", alternative=alt_direction)
   116	            except ValueError:
   117	                w_stat, w_p_one = float("nan"), 1.0
   118	
   119	            # C3 fix: bootstrap percentile 95% CI on mean diff (resample tasks)
   120	            boot_means = np.empty(n_boot)
   121	            for b in range(n_boot):
   122	                idx = rng.integers(0, n_tasks, size=n_tasks)
   123	                boot_means[b] = diff[idx].mean()
   124	            ci_lo, ci_hi = float(np.percentile(boot_means, 2.5)), float(np.percentile(boot_means, 97.5))
   125	
   126	        rows.append({
   127	            "layer": L,
   128	            "mean_layer": float(layer_vals.mean()),
   129	            "mean_baseline": float(baseline.mean()),
   130	            "mean_diff": float(diff.mean()),
   131	            "std_diff": float(diff.std(ddof=1)) if n_tasks > 1 else 0.0,
   132	            "ci_lo_95": ci_lo,
   133	            "ci_hi_95": ci_hi,
   134	            "t_stat": float(t_stat),
   135	            "t_p_one_sided": float(t_p_one),
   136	            "wilcoxon_p_one_sided": float(w_p_one),
   137	        })
   138	        raw_pvals.append(t_p_one)
   139	
   140	    holm = holm_correct(raw_pvals)
   141	    for row, (adj, rej) in zip(rows, holm):
   142	        row["t_p_holm_adj"] = adj
   143	        row["holm_reject_h0"] = rej
   144	
   145	    return {
   146	        "label": label,
   147	        "metric": metric,
   148	        "n_tasks": n_tasks,
   149	        "baseline_layer": BASELINE_LAYER,
   150	        "rows": rows,
   151	    }
