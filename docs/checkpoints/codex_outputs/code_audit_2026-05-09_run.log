   185	def fmt_p(p: float) -> str:
   186	    if p < 0.001:
   187	        return "<0.001 ***"
   188	    if p < 0.01:
   189	        return f"{p:.3f} **"
   190	    if p < 0.05:
   191	        return f"{p:.3f} *"
   192	    return f"{p:.3f}"
