   236	def bonferroni_adjust(pvals: list) -> list:
   237	    """Bonferroni: p_adj = min(1, m * p_raw); None entries pass-through."""
   238	    m = sum(1 for p in pvals if p is not None)
   239	    if m == 0:
   240	        return list(pvals)
   241	    return [min(1.0, m * p) if p is not None else None for p in pvals]
   242	
   243	
   244	def holm_bonferroni_adjust(pvals: list) -> list:
   245	    """Holm-Bonferroni step-down (Holm 1979): less conservative than Bonferroni
   246	    while still controlling family-wise error rate at α.
   247	
   248	    Sort non-None p-values ascending; the k-th smallest gets multiplied by
   249	    (m - k + 1) where m = number of non-None tests; running max enforces
   250	    monotonicity.
   251	    """
   252	    indexed = [(i, p) for i, p in enumerate(pvals) if p is not None]
   253	    indexed.sort(key=lambda x: x[1])
   254	    m = len(indexed)
   255	    out: list = [None] * len(pvals)
   256	    prev = 0.0
   257	    for k, (i, p) in enumerate(indexed):
   258	        adj = min(1.0, max(prev, p * (m - k)))
   259	        out[i] = adj
   260	        prev = adj
   261	    return out
   262	
   263	
   264	def bh_fdr_adjust(pvals: list) -> list:
   265	    """Benjamini-Hochberg FDR adjusted q-values (BH 1995).
   266	
   267	    Less conservative than FWER methods; controls expected proportion of false
   268	    discoveries among rejections rather than family-wise error rate.
   269	    """
   270	    indexed = [(i, p) for i, p in enumerate(pvals) if p is not None]
   271	    indexed.sort(key=lambda x: x[1])
   272	    m = len(indexed)
   273	    out: list = [None] * len(pvals)
   274	    prev = 1.0
   275	    for k in range(m - 1, -1, -1):
   276	        i, p = indexed[k]
   277	        rank = k + 1
   278	        adj = min(prev, p * m / rank)
   279	        out[i] = min(1.0, adj)
   280	        prev = out[i]
   281	    return out
   282	
   283	
   284	def analyze_cell(cell: dict) -> Optional[dict]:
   285	    """Compute phantom lift for a single (baseline, site) cell.
   286	
   287	    Required modes: DOM, SoM, Vision, P-SoM. P-text and P-prompt are optional —
   288	    when absent, dependent oracle/lift columns are emitted as None (CSV blank).
   289	
   290	    Returns None if any required mode missing or below MIN_EP_FOR_CELL.
   291	    """
   292	    succ, obs = {}, {}
   293	    for mode, ep_dir in cell["modes"].items():
   294	        s, o = load(ep_dir)
   295	        if len(o) < MIN_EP_FOR_CELL:
   296	            # Skip undersized modes silently; allow rest of cell to still build.
   297	            # P-prompt cell may be partial (e.g. 127/210); keep it if it meets MIN.
   298	            continue
   299	        succ[mode] = s
   300	        obs[mode] = o
   301	
   302	    required = ("DOM", "SoM", "Vision", "P-SoM")
   303	    if any(m not in succ for m in required):
   304	        return None
   305	    has_pdom = "P-text" in succ
   306	    has_pprompt = "P-prompt" in succ
   307	
   308	    # Common observed universe (intersection across all present modes)
   309	    common = set.intersection(*obs.values())
   310	    n = len(common)
   311	    if n < MIN_EP_FOR_CELL:
   312	        return None
   313	
   314	    # Restrict each mode's success set to common universe
   315	    succ_r = {m: s & common for m, s in succ.items()}
   316	
