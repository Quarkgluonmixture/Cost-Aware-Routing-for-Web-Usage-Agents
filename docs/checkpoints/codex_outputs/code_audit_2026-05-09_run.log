    86	    ("5_vs_3",        "3→5-mode oracle lift"),
    87	    ("4pdom_vs_3",    "P-text drop-in"),
    88	    ("4psom_vs_3",    "P-SoM drop-in"),
    89	    ("4pprompt_vs_3", "P-prompt drop-in"),
    90	    ("6_vs_3",        "6-mode oracle lift"),
