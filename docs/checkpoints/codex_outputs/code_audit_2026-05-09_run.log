    90	def compute_adjusted_success_batch(ep_df, benchmark_site: str, benchmark: str = "visualwebarena"):
    91	    """Add adjusted_success + fp_reason columns to ep_df.
    92	
    93	    Requires columns: task_id, success.
    94	    Returns ep_df with new columns added in-place.
    95	
    96	    Fast-path (§97 audit Step 2): if ep_df already carries `adjusted_success`
    97	    AND `fp_reason` columns (runner-computed since §97), skip recomputation.
    98	    The runner is the single source of truth; this batch path is kept for
    99	    backward compatibility with episode summaries written before §97.
   100	    """
   101	    if (
   102	        not ep_df.empty
   103	        and "adjusted_success" in ep_df.columns
   104	        and "fp_reason" in ep_df.columns
   105	        and ep_df["adjusted_success"].notna().all()
   106	    ):
   107	        # Already populated by runner — skip O(N) lambda apply.
   108	        return ep_df
   109	
   110	    na_ids = _load_na_task_ids(benchmark_site, benchmark)
   111	
   112	    adj_results = ep_df.apply(
   113	        lambda r: compute_adjusted_success(
   114	            int(r["task_id"]), benchmark_site,
   115	            bool(r["success"]),
   116	            na_task_ids=na_ids,
   117	            agent_finished=bool(r["agent_finished"]) if "agent_finished" in r.index else None,
   118	            eval_type=str(r["eval_type"]) if "eval_type" in r.index else None,
   119	            has_effective_action=bool(r["has_effective_action"]) if "has_effective_action" in r.index else None,
   120	        ),
   121	        axis=1,
   122	    )
   123	    ep_df["adjusted_success"] = [r[0] for r in adj_results]
   124	    ep_df["fp_reason"] = [r[1] for r in adj_results]
   125	    return ep_df
