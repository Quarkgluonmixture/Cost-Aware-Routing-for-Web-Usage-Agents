   128	    matches: list[dict] = []
   129	    if phase_dir is None or not phase_dir.exists():
   130	        return matches
   131	    site_pat = re.compile(rf"_{re.escape(site_seg)}_\d{{8}}")
   132	    for run_dir in phase_dir.iterdir():
   133	        if not run_dir.is_dir():
