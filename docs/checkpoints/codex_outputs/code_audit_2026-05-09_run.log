    61	
    62	# ---------------------------------------------------------------------------
    63	# H1: Phantom-SoM ≥ best of (DOM, SoM, Vision) per cell
    64	# ---------------------------------------------------------------------------
    65	
    66	def evaluate_h1(cells: list[dict], k_threshold: int) -> dict:
    67	    """For each cell, count if SR_phantom_som >= max(SR_dom, SR_som, SR_vision)."""
    68	    per_cell = []
    69	    for c in cells:
    70	        psom = float(c["sr_phantom_som"])
    71	        baselines = [float(c["sr_dom"]), float(c["sr_som"]), float(c["sr_vision"])]
    72	        best_baseline = max(baselines)
    73	        winner = psom >= best_baseline
    74	        per_cell.append({
    75	            "cell_id": c["cell_id"],
    76	            "sr_phantom_som": psom,
    77	            "best_baseline_sr": best_baseline,
    78	            "delta_pp": (psom - best_baseline) * 100.0,  # in percentage points
    79	            "phantom_som_wins": winner,
    80	        })
    81	    n_pass = sum(1 for r in per_cell if r["phantom_som_wins"])
    82	    n_total = len(per_cell)
    83	
    84	    # Two-sided binomial p-value under H0: p = 0.5 (random tie-breaking)
    85	    p_binomial = _binomial_test_two_sided(n_pass, n_total, 0.5)
    86	
    87	    return {
    88	        "n_cells": n_total,
    89	        "n_pass": n_pass,
    90	        "k_threshold": k_threshold,
    91	        "decision": "PASS" if n_pass >= k_threshold else "FAIL",
    92	        "p_binomial_h0_random": p_binomial,
    93	        "per_cell": per_cell,
    94	    }
    95	
    96	
    97	# ---------------------------------------------------------------------------
    98	# H3: Drop-one oracle lift from Phantom-SoM ≥ <delta_pp> in K_h3 cells
    99	# ---------------------------------------------------------------------------
   100	
   101	def evaluate_h3(cells: list[dict], k_threshold: int, lift_pp_min: float = 0.5) -> dict:
   102	    """Drop-one oracle lift: oracle_with_psom - oracle_3mode (DOM/SoM/Vision)
   103	    expressed in percentage points; pass if lift >= lift_pp_min for K_h3 cells."""
   104	    per_cell = []
   105	    for c in cells:
   106	        oracle_3 = float(c["oracle_3mode"])
   107	        oracle_drop_one = float(c["oracle_drop_one_psom"])
   108	        # Drop-one: oracle 4-mode - oracle 4-mode-without-PSoM
   109	        # Convention here: oracle_drop_one_psom = oracle 4-mode lift attributable to PSoM
   110	        # i.e., the marginal SR contribution if you remove PSoM from oracle bag
   111	        lift_pp = oracle_drop_one * 100.0
   112	        passes = lift_pp >= lift_pp_min
   113	        per_cell.append({
   114	            "cell_id": c["cell_id"],
   115	            "oracle_3mode_sr": oracle_3,
   116	            "drop_one_lift_pp": lift_pp,
   117	            "passes_min_lift": passes,
   118	        })
   119	    n_pass = sum(1 for r in per_cell if r["passes_min_lift"])
   120	
   121	    return {
   122	        "n_cells": len(cells),
   123	        "n_pass": n_pass,
   124	        "k_threshold": k_threshold,
   125	        "min_lift_pp": lift_pp_min,
   126	        "decision": "PASS" if n_pass >= k_threshold else "FAIL",
   127	        "per_cell": per_cell,
   128	    }
   129	
   130	
   131	# ---------------------------------------------------------------------------
   132	# TOST: equivalence test for cost(P-SoM) ≈ cost(DOM)
   133	# ---------------------------------------------------------------------------
   134	
   135	def evaluate_tost(cells: list[dict], delta_pp: float) -> dict:
   136	    """TOST (two one-sided tests) for cost equivalence within ±delta_pp.
   137	    Compute mean cost difference + 95% CI, check if CI ⊂ [-delta_pp, +delta_pp].
   138	    Cost expressed in percentage units (e.g., relative tokens or relative latency)."""
   139	    diffs = []
   140	    for c in cells:
   141	        cost_dom = float(c["cost_dom"])
   142	        cost_psom = float(c["cost_psom"])
   143	        if cost_dom == 0:
   144	            continue  # avoid div-by-zero
   145	        rel_diff_pp = (cost_psom - cost_dom) / cost_dom * 100.0
   146	        diffs.append(rel_diff_pp)
   147	
   148	    if not diffs:
   149	        return {"decision": "FAIL", "reason": "no valid diffs"}
   150	
   151	    n = len(diffs)
   152	    mean_diff = sum(diffs) / n
   153	    var = sum((d - mean_diff) ** 2 for d in diffs) / max(1, n - 1)
   154	    sd = math.sqrt(var)
   155	    sem = sd / math.sqrt(n)
   156	    # 95% CI using t-distribution approx (df = n-1, t_0.975 ≈ 1.96 for n>=30, ~2.13 for n=16)
   157	    t_crit = 2.131 if n <= 16 else 1.96
   158	    ci_lo = mean_diff - t_crit * sem
   159	    ci_hi = mean_diff + t_crit * sem
   160	
   161	    inside_band = (ci_lo > -delta_pp) and (ci_hi < delta_pp)
   162	
   163	    return {
   164	        "n_cells": n,
   165	        "delta_pp": delta_pp,
   166	        "mean_diff_pp": mean_diff,
   167	        "ci_95": [ci_lo, ci_hi],
   168	        "decision": "PASS" if inside_band else "FAIL",
   169	        "interpretation": (
   170	            f"95% CI [{ci_lo:.2f}, {ci_hi:.2f}] {'⊂' if inside_band else '⊄'} "
   171	            f"[-{delta_pp:.1f}, +{delta_pp:.1f}]"
   172	        ),
   173	        "raw_diffs_pp": diffs,
   174	    }
   175	
   176	
   177	# ---------------------------------------------------------------------------
   178	# Stats helpers
   179	# ---------------------------------------------------------------------------
   180	
   181	def _binomial_test_two_sided(k: int, n: int, p: float) -> float:
   182	    """Two-sided binomial p-value for k successes in n trials under H0: P(success)=p.
   183	    Sums tail probabilities ≤ observed."""
   184	    from math import comb
   185	    obs_p = comb(n, k) * (p ** k) * ((1 - p) ** (n - k))
   186	    total = 0.0
   187	    for kk in range(0, n + 1):
   188	        pp = comb(n, kk) * (p ** kk) * ((1 - p) ** (n - kk))
   189	        if pp <= obs_p + 1e-15:
   190	            total += pp
   191	    return min(1.0, total)
   192	
